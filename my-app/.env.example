# Copy to .env.local for local development, and set the same values in Vercel.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of this site (used for Stripe success/cancel redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Video compression service (backend/). Must be HTTPS in production,
# or browsers will block the request from the HTTPS site.
NEXT_PUBLIC_VIDEO_API_URL=http://localhost:5000

# Stripe test-mode keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
