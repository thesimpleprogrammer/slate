# Copy to .env for local runs. On EC2 the deploy reads /etc/slate/backend.env.

# Supabase project used to check that uploads come from a logged-in admin
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Sites allowed to call the API, comma-separated
ALLOWED_ORIGINS=http://localhost:3000,https://slate-sage.vercel.app

PORT=5000
MAX_UPLOAD_MB=200
MAX_VIDEO_WIDTH=1080
MAX_CONCURRENT_JOBS=2
